{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Standards rollout: discover the published migration version, apply files, and hand pending decisions to an external agent. A human merges migration PRs. See docs/standards-rollout.md for the contract.",
  "customDatasources": {
    "sebastian-software-standards": {
      "defaultRegistryUrlTemplate": "https://unpkg.com/@sebastian-software/standards@latest/manifest.json",
      "format": "json",
      "transformTemplates": ["{ \"releases\": [ { \"version\": $string(currentVersion) } ] }"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.repometa\\.json$/"],
      "matchStrings": ["\"standards\":\\s*(?<currentValue>\\d+)"],
      "datasourceTemplate": "custom.sebastian-software-standards",
      "depNameTemplate": "standards",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Update exact standards CLI pins in GitHub and Forgejo workflows, including Rust-only consumers without package.json.",
      "managerFilePatterns": ["/^\\.(?:github|forgejo)/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "@sebastian-software/standards@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)\\s+(?:check|ci)\\b"
      ],
      "depNameTemplate": "@sebastian-software/standards",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Only integer-stamp updates run apply and create pending agent work. The custom datasource has no release timestamp, so bypass its age gate. Migration PRs require human review; the agent sets the review label after completing its work.",
      "matchDatasources": ["custom.sebastian-software-standards"],
      "matchPackageNames": ["standards"],
      "dependencyDashboardApproval": false,
      "minimumReleaseAge": "0",
      "recreateWhen": "always",
      "addLabels": ["standards:needs-agent"],
      "commitMessagePrefix": "chore: ",
      "commitMessageTopic": "standards",
      "commitMessageAction": "",
      "commitMessageExtra": "v{{newVersion}}",
      "postUpgradeTasks": {
        "commands": [
          "pnpm --config.minimum-release-age=0 dlx @sebastian-software/standards apply --from-version {{{currentValue}}} --emit-pending .standards/pending.json"
        ],
        "fileFilters": ["**/*"],
        "executionMode": "branch",
        "installTools": {
          "node": {},
          "pnpm": {}
        }
      },
      "automerge": false
    }
  ]
}
